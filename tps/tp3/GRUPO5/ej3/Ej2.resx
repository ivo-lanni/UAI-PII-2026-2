        private void button1_Click(object sender, EventArgs e)
        {
            int cantidad;
            decimal numero, suma = 0;

            cantidad = (int)numericUpDown1.Value;

            textBox1.Clear();

            for (int i = 1; i <= cantidad; i++)
            {
                numero = Decimal.Parse(
                    Microsoft.VisualBasic.Interaction.InputBox(
                        "Ingrese el número " + i,
                        "Carga de números"
                    )
                );

                suma = suma + numero;

                textBox1.AppendText(numero + " + " + Environment.NewLine);
            }

            label1.Text = "Resultado: " + suma;
        }

